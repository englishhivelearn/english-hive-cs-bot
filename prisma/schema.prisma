generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model KnowledgeCategory {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  knowledge Knowledge[]

  @@map("knowledge_categories")
}

model Knowledge {
  id              Int                @id @default(autoincrement())
  categoryId      Int
  title           String
  content         String
  category        KnowledgeCategory  @relation(fields: [categoryId], references: [id])
  keywords        KnowledgeKeyword[]
  // Kombinasi kata WAJIB muncul bersamaan (AND-logic).
  // Format: array of array of string, mis:
  // [["jadwal","hari"], ["jadwal","jam"]]
  // Match kalau SALAH SATU grup (OR antar-grup) semua kata di dalamnya
  // (AND dalam grup) muncul di pesan user.
  requiredGroups  Json?
  // Kata yang kalau muncul di pesan user, knowledge ini di-SKIP total
  // meski keyword/requiredGroups cocok. Format: array of string.
  // Mis: ["pindah","ganti","reschedule"] untuk knowledge "Info Jadwal"
  // supaya tidak salah nyantol ke pertanyaan reschedule.
  excludeKeywords Json?
  // Berapa kali knowledge ini pernah "menang" dipilih sebagai jawaban.
  // Dipakai sebagai bonus kecil (tie-breaker) saat skor antar-entry
  // berdekatan -- entry yang lebih sering relevan sedikit diprioritaskan.
  matchCount      Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("knowledge")
}

model KnowledgeKeyword {
  id          Int       @id @default(autoincrement())
  knowledgeId Int
  keyword     String
  knowledge   Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([keyword])
  @@map("knowledge_keywords")
}

model ConversationSession {
  phone     String   @id
  step      String?
  context   Json?
  updatedAt DateTime @updatedAt

  @@map("conversation_sessions")
}

// Log pertanyaan yang GAGAL dijawab bot (tidak match / confidence rendah /
// ambigu). Admin bisa review di dashboard untuk tahu pola pertanyaan asli
// customer dan menambah/perbaiki knowledge base berdasarkan data nyata,
// bukan tebakan -- inilah "belajar" yang dilakukan sistem ini: bukan AI,
// tapi feedback loop berbasis data pemakaian nyata.
model UnansweredQuery {
  id         Int      @id @default(autoincrement())
  phone      String
  message    String
  reason     String   // "no_match" | "ambiguous" | "low_confidence"
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([resolved])
  @@map("unanswered_queries")
}