# Diisi otomatis oleh Railway saat kamu attach PostgreSQL plugin
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Lokasi folder auth Baileys. Arahkan ke path Volume di Railway, mis: /data/auth_info
BAILEYS_AUTH_DIR="./auth_info"

# Port untuk Next.js (Railway mengisi otomatis, biarkan saja)
PORT=3000
